# ---------------------------------------------------------------------------
# Analytics & error reporting (optional)
# ---------------------------------------------------------------------------
# beats.me runs fine with these left blank — analytics and error reporting just
# stay off. They only activate in a production build (`npm run build`);
# `npm run dev` never sends data regardless.
#
# These are client-side, write-only keys. Vite inlines them into the built
# bundle, so they are NOT secret. Set them only if you want events/errors sent
# to your OWN PostHog / Sentry projects.
#
# To use: copy this file to `.env.local` (gitignored) and fill in your values.

# PostHog project API key — starts with "phc_".
# Get one: https://posthog.com  (Project Settings -> Project API Key)
VITE_POSTHOG_KEY=

# Sentry DSN — looks like https://<hash>@<org>.ingest.<region>.sentry.io/<id>
# Get one: https://sentry.io  (Project Settings -> Client Keys (DSN))
VITE_SENTRY_DSN=
